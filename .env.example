# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=focusarc

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS (frontend origin, only needed if serving frontend from a different origin/port)
CORS_ORIGIN=http://localhost:3000
